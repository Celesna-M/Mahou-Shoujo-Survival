    Energy recharge or refill in Lobby.</color>
  inspectorActionDefaultStageBanner: 'RANK E : ABANDONED CLASSROOM'
  inspectorActionStageStartBannerFormat: 
  inspectorActionBossApproachingBannerFormat: 'WARNING: RANK {0} GUARDIAN APPROACHING'
  inspectorActionStageClearBanner: STAGE CLEAR!
  inspectorActionStageClearFirstTimeBannerFormat: 'STAGE CLEAR!

    <size=24><color=#FFD700>FIRST-CLEAR
    BONUS: +{0} DUST | +{1} CORE</color></size>'
  inspectorEnemyDefaultNormalName: THE ENTITY
  inspectorEnemyDefaultBossNameFormat: RANK {0} GUARDIAN (BOSS)
  inspectorHudExecutePromptText: '[F] EXECUTE (HEAL HP)'
  inspectorHudStarDustCounterFormat: 'STAR DUST : {0}'
  inspectorHudShatteredCoreCounterFormat: 'CORE : {0}'
  inspectorHudFloatingGainFormat: + [{0}] {1}{2}
  inspectorHudIconStarDust: STAR DUST
  inspectorHudIconShatteredCore: CORE
  inspectorHudIconMilestone: MILESTONE
  inspectorHudKillMilestoneSuffixFormat: ' ({0} KILLS!)'
  inspectorVictoryHeaderFormat: "<b>STAGE CLEAR \u2014 RANK {0}</b>"
  inspectorVictoryStarDustLineFormat: '<color=#FFE040>+ [STAR DUST] : {0} (TOTAL:
    {1})</color>'
  inspectorVictoryShatteredCoreLineFormat: '<color=#F259FF>+ [SHATTERED CORE] : {0}
    (TOTAL: {1})</color>'
  inspectorVictoryFirstClearBonusLineFormat: '

    <color=#FFD700>[FIRST-CLEAR BONUS!]
    +{0} STAR DUST | +{1} CORE</color>'
  inspectorVictoryRankPromotionLineFormat: '

    <color=#00FFAA>[RANK PROMOTION!]
    UNLOCKED RANK {0} ({1})</color>

    <size=17><color=#FF99BB>{2}</color></size>'
  inspectorMascotSpeakerName: KYU-DOLL (CURSED MASCOT)
  inspectorMascotRandomDialogues:
  - "\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E2D\u0E35\u0E01\u0E41\u0E25\u0E49\u0E27\u0E40\u0E2B\u0E23\u0E2D?
    \u0E27\u0E34\u0E0D\u0E0D\u0E32\u0E13\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E17\u0E31\u0E19\u0E41\u0E15\u0E01\u0E2A\u0E25\u0E32\u0E22\u0E40\u0E25\u0E22\u0E19\u0E30...
    \u0E19\u0E48\u0E32\u0E40\u0E2A\u0E35\u0E22\u0E14\u0E32\u0E22\u0E08\u0E31\u0E07"
  - "\u0E40\u0E28\u0E29 Star Dust \u0E1E\u0E27\u0E01\u0E19\u0E31\u0E49\u0E19... \u0E23\u0E39\u0E49\u0E44\u0E2B\u0E21\u0E27\u0E48\u0E32\u0E21\u0E31\u0E19\u0E40\u0E04\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E27\u0E32\u0E21\u0E2B\u0E27\u0E31\u0E07\u0E02\u0E2D\u0E07\u0E2A\u0E32\u0E27\u0E19\u0E49\u0E2D\u0E22\u0E40\u0E27\u0E17\u0E21\u0E19\u0E15\u0E23\u0E4C\u0E04\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E46
    \u0E19\u0E48\u0E30?"
  - "\u0E22\u0E34\u0E48\u0E07\u0E40\u0E18\u0E2D\u0E2D\u0E31\u0E1B\u0E40\u0E01\u0E23\u0E14\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E21\u0E32\u0E01\u0E40\u0E17\u0E48\u0E32\u0E44\u0E2B\u0E23\u0E48
    \u0E41\u0E2A\u0E07\u0E2A\u0E35\u0E0A\u0E21\u0E1E\u0E39\u0E43\u0E19\u0E15\u0E31\u0E27\u0E40\u0E18\u0E2D\u0E01\u0E47\u0E22\u0E34\u0E48\u0E07\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E35\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E21\u0E32\u0E01\u0E02\u0E36\u0E49\u0E19\u0E40\u0E17\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19...
    \u0E2A\u0E31\u0E07\u0E40\u0E01\u0E15\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E1B\u0E25\u0E48\u0E32?"
  - "\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19\u0E1A\u0E32\u0E19\u0E19\u0E31\u0E49\u0E19\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E02\u0E31\u0E07\u0E1E\u0E27\u0E01\u0E21\u0E31\u0E19\u0E44\u0E27\u0E49\u0E2B\u0E23\u0E2D\u0E01...
    \u0E21\u0E31\u0E19\u0E02\u0E31\u0E07 '\u0E1E\u0E27\u0E01\u0E40\u0E18\u0E2D' \u0E15\u0E48\u0E32\u0E07\u0E2B\u0E32\u0E01"
  - "Shattered Core \u0E2D\u0E38\u0E48\u0E19\u0E14\u0E35\u0E43\u0E0A\u0E48\u0E44\u0E2B\u0E21\u0E25\u0E48\u0E30?
    \u0E01\u0E34\u0E19\u0E21\u0E31\u0E19\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B\u0E40\u0E22\u0E2D\u0E30\u0E46
    \u0E2A\u0E34 \u0E41\u0E25\u0E49\u0E27\u0E40\u0E18\u0E2D\u0E08\u0E30\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E1A\u0E2D\u0E2A\u0E15\u0E31\u0E27\u0E15\u0E48\u0E2D\u0E44\u0E1B\u0E02\u0E2D\u0E07\u0E21\u0E34\u0E15\u0E34\u0E19\u0E35\u0E49\u0E40\u0E2D\u0E07"
  - "\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E25\u0E31\u0E27\u0E04\u0E27\u0E32\u0E21\u0E15\u0E32\u0E22\u0E2B\u0E23\u0E2D\u0E01
    \u0E43\u0E19\u0E25\u0E39\u0E1B\u0E21\u0E34\u0E15\u0E34\u0E19\u0E35\u0E49... \u0E41\u0E21\u0E49\u0E41\u0E15\u0E48\u0E04\u0E27\u0E32\u0E21\u0E15\u0E32\u0E22\u0E01\u0E47\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E2D\u0E19\u0E38\u0E0D\u0E32\u0E15\u0E43\u0E2B\u0E49\u0E40\u0E18\u0E2D\u0E1E\u0E31\u0E01\u0E1C\u0E48\u0E2D\u0E19"
  inspectorUpgrade1VitalityItemLore: "\u0E40\u0E28\u0E29\u0E25\u0E30\u0E2D\u0E2D\u0E07\u0E14\u0E32\u0E27\u0E17\u0E35\u0E48\u0E15\u0E01\u0E1C\u0E25\u0E36\u0E01\u0E08\u0E32\u0E01\u0E04\u0E33\u0E2D\u0E18\u0E34\u0E29\u0E10\u0E32\u0E19\u0E17\u0E35\u0E48\u0E25\u0E49\u0E21\u0E40\u0E2B\u0E25\u0E27
    \u0E0A\u0E48\u0E27\u0E22\u0E22\u0E37\u0E14\u0E2D\u0E32\u0E22\u0E38\u0E02\u0E31\u0E22\u0E02\u0E2D\u0E07\u0E20\u0E32\u0E0A\u0E19\u0E30\u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E23\u0E49\u0E32\u0E27\u0E09\u0E32\u0E19"
  inspectorUpgrade2StaminaItemLore: "\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E2A\u0E30\u0E17\u0E49\u0E2D\u0E19\u0E02\u0E2D\u0E07\u0E04\u0E19\u0E17\u0E35\u0E48\u0E1E\u0E22\u0E32\u0E22\u0E32\u0E21\u0E27\u0E34\u0E48\u0E07\u0E2B\u0E19\u0E35\u0E08\u0E32\u0E01\u0E25\u0E39\u0E1B\u0E21\u0E34\u0E15\u0E34\u0E19\u0E35\u0E49...
    \u0E41\u0E21\u0E49\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22\u0E08\u0E30\u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23\u0E2B\u0E19\u0E35\u0E1E\u0E49\u0E19\u0E01\u0E47\u0E15\u0E32\u0E21"
  inspectorUpgrade3RawPowerItemLore: "\u0E41\u0E01\u0E48\u0E19\u0E27\u0E34\u0E0D\u0E0D\u0E32\u0E13\u0E2A\u0E35\u0E21\u0E48\u0E27\u0E07\u0E04\u0E25\u0E49\u0E33\u0E17\u0E35\u0E48\u0E04\u0E27\u0E31\u0E01\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E08\u0E32\u0E01\u0E23\u0E48\u0E32\u0E07\u0E1C\u0E39\u0E49\u0E04\u0E38\u0E21\u0E21\u0E34\u0E15\u0E34
    \u0E21\u0E31\u0E19\u0E40\u0E15\u0E49\u0E19\u0E15\u0E38\u0E1A\u0E46 \u0E41\u0E25\u0E30\u0E01\u0E23\u0E30\u0E2B\u0E32\u0E22\u0E01\u0E32\u0E23\u0E2A\u0E31\u0E07\u0E2B\u0E32\u0E23\u0E04\u0E23\u0E31\u0E49\u0E07\u0E15\u0E48\u0E2D\u0E44\u0E1B"
  inspectorDeathScreenTauntQuotes:
  - "\u0E2D\u0E35\u0E01\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E04\u0E27\u0E32\u0E21\u0E2B\u0E27\u0E31\u0E07\u0E17\u0E35\u0E48\u0E41\u0E2B\u0E25\u0E01\u0E2A\u0E25\u0E32\u0E22..."
  - "\u0E04\u0E33\u0E2D\u0E18\u0E34\u0E29\u0E10\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D...
    \u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23\u0E44\u0E14\u0E49\u0E22\u0E34\u0E19\u0E43\u0E19\u0E21\u0E34\u0E15\u0E34\u0E19\u0E35\u0E49\u0E2B\u0E23\u0E2D\u0E01"
  - "\u0E42\u0E0B\u0E25\u0E40\u0E08\u0E21\u0E17\u0E35\u0E48\u0E21\u0E37\u0E14\u0E21\u0E34\u0E14...
    \u0E01\u0E33\u0E25\u0E31\u0E07\u0E01\u0E25\u0E37\u0E19\u0E01\u0E34\u0E19\u0E0A\u0E37\u0E48\u0E2D\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E44\u0E1B\u0E17\u0E35\u0E25\u0E30\u0E19\u0E34\u0E14"
  - "\u0E25\u0E39\u0E1B\u0E40\u0E27\u0E25\u0E32\u0E2B\u0E21\u0E38\u0E19\u0E01\u0E25\u0E31\u0E1A\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07...
    \u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E1A\u0E32\u0E14\u0E41\u0E1C\u0E25\u0E17\u0E35\u0E48\u0E25\u0E36\u0E01\u0E01\u0E27\u0E48\u0E32\u0E40\u0E14\u0E34\u0E21"
  - "\u0E41\u0E21\u0E49\u0E41\u0E15\u0E48\u0E04\u0E27\u0E32\u0E21\u0E15\u0E32\u0E22...
    \u0E01\u0E47\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E2D\u0E19\u0E38\u0E0D\u0E32\u0E15\u0E43\u0E2B\u0E49\u0E40\u0E18\u0E2D\u0E2B\u0E25\u0E38\u0E14\u0E1E\u0E49\u0E19\u0E08\u0E32\u0E01\u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19\u0E19\u0E35\u0E49"
