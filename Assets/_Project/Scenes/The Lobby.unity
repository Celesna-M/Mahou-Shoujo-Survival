  inspectorSettingsVolumeFormat: '{0}%'
  inspectorSettingsSensitivityFormat: '{0:F1}x'
  inspectorSettingsFullscreenOn: FULLSCREEN
  inspectorSettingsFullscreenOff: WINDOWED
  inspectorRankLetters:
  - E
  - D
  - C
  - B
  - A
  - S
  inspectorRankZoneNames:
  - ABANDONED CLASSROOM
  - DERELICT CITY STREET
  - SHATTERED SUBWAY LINE
  - FACELESS COMMERCIAL DISTRICT
  - CRIMSON SANCTUM CORRIDOR
  - CORE OF THE ABYSS
  inspectorRankStoryLogs:
  - 'STORY [RANK E] : Woke up inside an empty classroom. Dark static seals every
    window.'
  - 'STORY [RANK D] : Beyond the school gate, the city streets are frozen under a
    blood-red sky.'
  - 'STORY [RANK C] : Deep in the subway tunnels, the entities whisper fragments
    of our forgotten names.'
  - 'STORY [RANK B] : My Soul Gem burns darker with every battle. The loop is beginning
    to fracture.'
  - 'STORY [RANK A] : At the end of the crimson corridor, the source of the anomaly
    pulses ahead.'
  - 'STORY [RANK S] : The Abyss Core is breached. I am no longer prey trapped in
    this dimension.'
  inspectorMilestoneTier1Format: "[MILESTONE TIER 1 : FRAGILE SOUL] Kills: {0} |
    Upgrades: Lv.{1} \u2014 \"My hands are still trembling, but I must fight to survive.\""
  inspectorMilestoneTier2Format: "[MILESTONE TIER 2 : AWAKENED CREST] Kills: {0}
    | Upgrades: Lv.{1} \u2014 \"The Star Dust is merging with my pulse. The pink
    light is turning sharp.\""
  inspectorMilestoneTier3Format: "[MILESTONE TIER 3 : CRIMSON RESONANCE] Kills: {0}
    | Upgrades: Lv.{1} \u2014 \"Shattered Cores fuel my strikes. The entities now
    hesitate before me.\""
  inspectorMilestoneTier4Format: "[MILESTONE TIER 4 : ABYSS SOVEREIGN] Kills: {0}
    | Upgrades: Lv.{1} \u2014 \"Crimson light surrounds me. This dimension can no
    longer hold me captive.\""
  inspectorCharacterIds:
  - CHAR_01
  - CHAR_02
  - CHAR_03
  inspectorCharacterNames:
  - '01 : HIKARI - BRAWLER STRIKER'
  - '02 : AKANE - CRIMSON BREAKER'
  - '03 : SHIRO - AEGIS GUARDIAN'
  inspectorCharacterLores:
  - Balanced Striker | High mobility and fast melee combos.
  - Heavy Breaker | Crushes enemy stagger gauges with heavy blows.
  - Aegis Tank | High base health built for surviving relentless swarms.
  inspectorLobbyEnergyRechargingFormat: 'ENERGY : {0} / {1} (+1 in {2}s)'
  inspectorLobbyEnergyMaxFormat: 'ENERGY : {0} / {1} (MAX)'
  inspectorLobbyStarDustFormat: 'STAR DUST : {0}'
  inspectorLobbyShatteredCoreFormat: 'SHATTERED CORE : {0}'
  inspectorLobbyShatteredCoreWithEnergyFormat: 'SHATTERED CORE : {0}  |  ENERGY :
    {1}/{2}'
  inspectorLobbyCombinedCurrencyFormat: 'STAR DUST : {0}  |  CORE : {1}  |  ENERGY
    : {2}/{3}'
  inspectorLobbySelectedCharTitleFormat: <b>{0}</b>  <color=#FFD700>[RANK {1}]</color>
  inspectorLobbySelectedCharLoreFormat: '{0}

    <color=#FF99BB>{1}</color></size>'
  inspectorLobbyCombinedStatsSummaryFormat: "<b>RANK {0} ({1}) \u2014 STATUS SUMMARY</b>\n-
    VITALITY (HP) : <b><color=#40FF80>{2:F0}</color></b>(Base {3:F0} + {4:F0} [Lv.{5}])\n-
    STAMINA EFF. : <b><color=#66E0FF>+{6:F0}/s Regen, -{7:F1} Dodge Cost</color></b>
    Lv.{8}]\n- RAW POWER (ATK) : <b><color=#FF6699>{9:F0}</color></b> (Base {10:F0}
    + {11:F0} [Lv.{12}])\n<color=#FF88AA>{13}</color>"
  inspectorLobbyUpgrade1VitalityFormat: '<b>1. VITALITY BOOST (+{0:F0} MAX HP)</b>

    Cost:
    {1} Star Dust  |  Lv.{2} ({3:F0} HP)'
  inspectorLobbyUpgrade2StaminaFormat: '<b>2. STAMINA EFFICIENCY (+{0:F0} Regen /
    -{1:F1} Dodge)</b>

    Cost: {2} Star Dust  |  Lv.{3}'
  inspectorLobbyUpgrade3RawPowerFormat: '<b>3. RAW POWER (+{0:F0} ATTACK)</b>

    Cost:
    {1} Shattered Core  |  Lv.{2} ({3:F0} ATK)'
  inspectorStageNodeCodes:
  - RANK E
  - RANK D
  - RANK C
  - RANK B
  - RANK A
  - RANK S
  inspectorStageNodeTitles:
  - 'RANK E : ABANDONED CLASSROOM'
  - 'RANK D : DERELICT CITY STREET'
  - 'RANK C : SHATTERED SUBWAY LINE'
  - 'RANK B : FACELESS PLAZA'
  - 'RANK A : CRIMSON SANCTUM'
  - 'RANK S : CORE OF THE ABYSS [FINAL]'
  inspectorStageNodeDescriptions:
  - Trapped in a derelict classroom. Break the static seal to escape outside.
  - Ruined city streets beneath a blood-red sky.
  - Underground tracks echoing with the whispers of fallen Magical Girls.
  - Collapsed commercial center swarming with aggressive entities.
  - Deep dimensional corridor guarded by Twin Elite Entities.
  - The heart of the dimensional loop where the Abyss Sovereign awaits.
  inspectorMapEnergyRechargingFormat: 'RANK {0}  |  ENERGY : {1} / {2} (+1 in {3}s)'
  inspectorMapEnergyMaxFormat: 'RANK {0}  |  ENERGY : {1} / {2} (MAX)'
  inspectorMapHeaderCharacterStatusFormat: '{0} <color=#FFD700>[RANK {1}]</color>

    HP:
    {2:F0} | ATK: {3:F0} | DUST: {4} | CORE: {5} | KILLS: {6}</size>'
  inspectorMapDeployButtonReadyFormat: ENTER RANK {0} (-{1} ENERGY) >
  inspectorMapDeployButtonNoEnergyFormat: NO ENERGY (0 / {0})
  inspectorMapSelectedStageTitleFormat: '{0}  <color=#FFD700>[RANK {1}]</color>'
  inspectorMapStageClearedBadge: <color=#40FF80>[CLEARED - REPEAT RUN]</color>
  inspectorMapStageFirstClearBadgeFormat: '<color=#FFD700>[FIRST-CLEAR BONUS: +{0}
